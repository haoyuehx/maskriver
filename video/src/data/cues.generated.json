[
  {
    "id": 1,
    "start": 1.6,
    "end": 7.2,
    "scene": 1,
    "text": "测试环境需要真实数据，却不需要真实的个人信息。"
  },
  {
    "id": 2,
    "start": 7.8,
    "end": 14.2,
    "scene": 1,
    "text": "复制一份业务库，姓名、邮箱、手机号就原样流出。"
  },
  {
    "id": 3,
    "start": 14.8,
    "end": 21,
    "scene": 1,
    "text": "MaskRiver 把这些风险收进一条可追踪的处理流水线。"
  },
  {
    "id": 4,
    "start": 21.4,
    "end": 24.8,
    "scene": 1,
    "text": "让脱敏从手工脚本，变成可验证的流程。"
  },
  {
    "id": 5,
    "start": 30.4,
    "end": 35.6,
    "scene": 2,
    "text": "第一步，扫描：证据不足时保留 UNKNOWN，而不是默认放行。"
  },
  {
    "id": 6,
    "start": 36.4,
    "end": 41.6,
    "scene": 2,
    "text": "第二步，预览：先给出处理计划，并证明预览阶段零写入。"
  },
  {
    "id": 7,
    "start": 42.4,
    "end": 47.6,
    "scene": 2,
    "text": "第三步，审批：Ed25519 记录绑定计划摘要，签名不符就无法执行。"
  },
  {
    "id": 8,
    "start": 48.4,
    "end": 53.6,
    "scene": 2,
    "text": "第四步，执行：只改计划字段，按批次提交事务。"
  },
  {
    "id": 9,
    "start": 54.4,
    "end": 59.6,
    "scene": 2,
    "text": "第五步，验证：行数、主键、Schema 与计划字段逐项核对。"
  },
  {
    "id": 10,
    "start": 60.2,
    "end": 64.4,
    "scene": 2,
    "text": "五步连成一条可审计的链路。"
  },
  {
    "id": 11,
    "start": 66.2,
    "end": 72,
    "scene": 3,
    "text": "下面走一遍完整流程，左边是一份合成的数据源。"
  },
  {
    "id": 12,
    "start": 72.6,
    "end": 79,
    "scene": 3,
    "text": "扫描之后，每个字段都带着结论与证据。"
  },
  {
    "id": 13,
    "start": 79.6,
    "end": 86.4,
    "scene": 3,
    "text": "证据不足的字段标记为需核对，而不是当作安全。"
  },
  {
    "id": 14,
    "start": 87,
    "end": 93.6,
    "scene": 3,
    "text": "预览生成处理计划：改哪些表、哪些字段、用什么策略。"
  },
  {
    "id": 15,
    "start": 94.2,
    "end": 100.6,
    "scene": 3,
    "text": "计划之外的数据一律不动，这是范围约束。"
  },
  {
    "id": 16,
    "start": 101.2,
    "end": 108.6,
    "scene": 3,
    "text": "但预览只能看不能写，零写入由驱动级证据证明。"
  },
  {
    "id": 17,
    "start": 109.2,
    "end": 116.6,
    "scene": 3,
    "text": "审批把计划摘要签进 Ed25519 记录，执行侧只加载公钥。"
  },
  {
    "id": 18,
    "start": 117.2,
    "end": 123.6,
    "scene": 3,
    "text": "没有有效审批，写入通道保持锁定。"
  },
  {
    "id": 19,
    "start": 124.2,
    "end": 131.6,
    "scene": 3,
    "text": "授权之后，敏感值按批次替换，非计划字段保持不变。"
  },
  {
    "id": 20,
    "start": 132.2,
    "end": 139.6,
    "scene": 3,
    "text": "每个批次提交时写下事务回执，为中断后的判断留下依据。"
  },
  {
    "id": 21,
    "start": 140.2,
    "end": 148.6,
    "scene": 3,
    "text": "最后是严格验证：行数、主键集合、Schema 与计划字段。"
  },
  {
    "id": 22,
    "start": 151,
    "end": 157.6,
    "scene": 4,
    "text": "真实数据的规模远不止几行，一次性加载并不现实。"
  },
  {
    "id": 23,
    "start": 158.2,
    "end": 165.6,
    "scene": 4,
    "text": "有界流式处理按批次读取，批次之间提交事务并留下回执。"
  },
  {
    "id": 24,
    "start": 166.2,
    "end": 173.6,
    "scene": 4,
    "text": "读取窗口有上限，处理量由资源预算与批次大小共同约束。"
  },
  {
    "id": 25,
    "start": 174.2,
    "end": 181.6,
    "scene": 4,
    "text": "所以内存占用随批次增长，而不是随整张表增长。"
  },
  {
    "id": 26,
    "start": 182.2,
    "end": 189.6,
    "scene": 4,
    "text": "每个批次都是独立事务，已提交的部分可以重新核对。"
  },
  {
    "id": 27,
    "start": 190.2,
    "end": 198.6,
    "scene": 4,
    "text": "这条路径针对本地 SQLite，其他数据库不在此承诺范围内。"
  },
  {
    "id": 28,
    "start": 201,
    "end": 207.6,
    "scene": 5,
    "text": "如果处理到一半，进程被中断了呢？"
  },
  {
    "id": 29,
    "start": 208.2,
    "end": 215.6,
    "scene": 5,
    "text": "恢复之前先做只读检查：Checkpoint、进度、回执与清单。"
  },
  {
    "id": 30,
    "start": 216.2,
    "end": 223.6,
    "scene": 5,
    "text": "已正确提交的批次被跳过，剩下的从断点继续。"
  },
  {
    "id": 31,
    "start": 224.2,
    "end": 231.6,
    "scene": 5,
    "text": "业务更新、回执、进度与清单，在同一个本地事务里提交。"
  },
  {
    "id": 32,
    "start": 232.2,
    "end": 239.6,
    "scene": 5,
    "text": "目标被外部改动时，恢复会拒绝继续，而不是自动覆盖。"
  },
  {
    "id": 33,
    "start": 240.2,
    "end": 245,
    "scene": 5,
    "text": "失败之后仍能给出确定结论，这才是可恢复。"
  },
  {
    "id": 34,
    "start": 246.2,
    "end": 251.8,
    "scene": 6,
    "text": "安全审批，可验证脱敏，故障恢复。"
  },
  {
    "id": 35,
    "start": 252.4,
    "end": 257.4,
    "scene": 6,
    "text": "MaskRiver，让数据脱敏更安全、更可控。"
  }
]
